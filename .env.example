# Copy to .env and fill in. Loaded automatically (with override) by the OCR/vision stages.
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Optional local overrides for the direnv/Nix peace-tool-pool MCP setup.
# Defaults intentionally track latest upstream main.
PEACE_TOOL_POOL_REPO=https://github.com/Lexikat-Pte-Ltd/peace-tool-pool.git
PEACE_TOOL_POOL_REF=main
PEACE_TOOL_POOL_ROOT=.cache/peace-tool-pool

# Optional tagged-PDF extraction through the local text layer and OpenCode vision.
# PIPELINE_OCR_BACKEND=digital
# PIPELINE_VISION_BACKEND=opencode
# PIPELINE_VISION_MODEL=openai/gpt-5.6-luna
# PIPELINE_VISION_WORKERS=4

# Optional extraction vision and analysis through an externally managed `opencode serve`.
# OPENCODE_SERVER_URL=http://127.0.0.1:8787
# ANALYSIS_LLM_BACKEND=opencode
# ANALYSIS_TABLE_MODEL=zai-coding-plan/glm-5.3-flash
# ANALYSIS_FIGURE_MODEL=opencode-go/deepseek-v4-flash
# ANALYSIS_SPAN_MODEL=zai-coding-plan/glm-5.3-flash
# ANALYSIS_IMAGE_MODEL=openai/gpt-5.6-luna
# ANALYSIS_ANSWER_MODEL=openai/gpt-5.6-luna
