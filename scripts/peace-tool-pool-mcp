#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_root="$(cd -- "$script_dir/.." && pwd)"

eval "$(bash "$script_dir/sync-peace-tool-pool.sh" --print-env)"

cd "$project_root"
exec uv run \
  --project "$PEACE_TOOL_POOL_ROOT" \
  --extra mcp \
  --extra detectors \
  --extra geo \
  --extra knowledge-local \
  peace-tool-pool-mcp
