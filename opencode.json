{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".claude/skills"]
  },
  "mcp": {
    "peace-tool-pool": {
      "type": "local",
      "command": ["bash", "scripts/peace-tool-pool-mcp"],
      "cwd": ".",
      "environment": {
        "PEACE_TOOL_POOL_REPO": "https://github.com/Lexikat-Pte-Ltd/peace-tool-pool.git",
        "PEACE_TOOL_POOL_REF": "main",
        "PEACE_TOOL_POOL_ROOT": ".cache/peace-tool-pool",
        "GEOMAP_MODEL_ROOT": "/home/elijah/peace-tool-pool/dependencies/models",
        "GEOMAP_ULTRALYTICS_ROOT": "/home/elijah/peace-tool-pool/dependencies/ultralytics"
      },
      "enabled": true,
      "timeout": 120000
    },
    "geo-report": {
      "type": "local",
      "command": ["uv", "run", "geo-report-mcp"],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  }
}
